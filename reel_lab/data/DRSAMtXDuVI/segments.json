[
 {
  "start": 0.0,
  "end": 1.18,
  "text": "There's people in your life right now"
 },
 {
  "start": 1.18,
  "end": 2.44,
  "text": "that think you're a dreamer"
 },
 {
  "start": 2.44,
  "end": 3.14,
  "text": "or you're crazy"
 },
 {
  "start": 3.14,
  "end": 4.14,
  "text": "or you lost your mind."
 },
 {
  "start": 4.36,
  "end": 5.0,
  "text": "That's okay."
 },
 {
  "start": 5.12,
  "end": 6.98,
  "text": "They don't build statues of critics."
 },
 {
  "start": 11.44,
  "end": 12.6,
  "text": "And all I know,"
 },
 {
  "start": 12.68,
  "end": 13.82,
  "text": "when we're 100 years old"
 },
 {
  "start": 13.82,
  "end": 14.68,
  "text": "and we look back,"
 },
 {
  "start": 15.08,
  "end": 16.24,
  "text": "we're not going to be happy"
 },
 {
  "start": 16.24,
  "end": 17.72,
  "text": "if we didn't take that last step."
 },
 {
  "start": 19.48,
  "end": 20.9,
  "text": "So go home and take that step."
 }
]